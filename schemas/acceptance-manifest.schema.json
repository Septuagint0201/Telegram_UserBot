{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/telegram-userbot/acceptance-manifest.schema.json",
  "title": "Telegram UserBot acceptance evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "milestone",
    "generated_at",
    "source",
    "environment",
    "disclosure",
    "locks",
    "requirements",
    "external_evidence"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "milestone": { "pattern": "^M[0-9]+$", "type": "string" },
    "generated_at": { "format": "date-time", "type": "string" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree", "dirty", "signed_commit"],
      "properties": {
        "commit": { "pattern": "^[0-9a-f]{40}$", "type": "string" },
        "tree": { "pattern": "^[0-9a-f]{40}$", "type": "string" },
        "dirty": { "const": false },
        "signed_commit": { "const": true }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["python", "implementation", "platform", "external_service_access"],
      "properties": {
        "python": { "type": "string" },
        "implementation": { "const": "CPython" },
        "platform": { "type": "string" },
        "external_service_access": { "const": false }
      }
    },
    "disclosure": { "$ref": "#/$defs/hashedFile" },
    "locks": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/hashedFile" }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": { "pattern": "^(?:M[0-9]+-[0-9]{3}|X-[0-9]{3})$", "type": "string" },
          "status": { "enum": ["PASS", "FAIL", "NOT RUN", "BLOCKED"] },
          "evidence": {
            "type": "array",
            "items": { "minLength": 1, "type": "string" },
            "uniqueItems": true
          },
          "reason": { "minLength": 1, "type": "string" }
        }
      }
    },
    "external_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "reason"],
        "properties": {
          "name": { "minLength": 1, "type": "string" },
          "status": { "enum": ["NOT RUN", "BLOCKED"] },
          "reason": { "minLength": 1, "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "hashedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "minLength": 1, "type": "string" },
        "sha256": { "pattern": "^[0-9a-f]{64}$", "type": "string" }
      }
    }
  }
}
