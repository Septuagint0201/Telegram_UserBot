{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/telegram-userbot/python-inventory.schema.json",
  "title": "Python dependency and license inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["bomFormat", "specVersion", "serialNumber", "version", "metadata", "components"],
  "properties": {
    "bomFormat": {"const": "CycloneDX"},
    "specVersion": {"const": "1.6"},
    "serialNumber": {"type": "string", "pattern": "^urn:uuid:[0-9a-f-]{36}$"},
    "version": {"const": 1},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timestamp", "component", "properties"],
      "properties": {
        "timestamp": {"type": "string", "format": "date-time"},
        "component": {"$ref": "#/$defs/component"},
        "properties": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/property"}
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/component"}
    }
  },
  "$defs": {
    "property": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "value": {"type": "string"}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "name", "version", "bom-ref"],
      "properties": {
        "type": {"enum": ["container", "library"]},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "bom-ref": {"type": "string", "minLength": 1},
        "purl": {"type": "string", "pattern": "^pkg:pypi/"},
        "licenses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["license"],
            "properties": {
              "license": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name"],
                "properties": {"name": {"type": "string", "minLength": 1}}
              }
            }
          }
        },
        "properties": {
          "type": "array",
          "items": {"$ref": "#/$defs/property"}
        }
      }
    }
  }
}
