# Non-secret systemd Operations identity. Copy to /etc/telegram-userbot/ops.env
# as root:root 0600 and replace every example value before enabling timers.
TUDT_COMPOSE_PROJECT=telegram-userbot-production
TUDT_COMPOSE_ENV=/etc/telegram-userbot/compose.env
TUDT_DEPLOYMENT_CONFIG=/etc/telegram-userbot/config/deployment.json
