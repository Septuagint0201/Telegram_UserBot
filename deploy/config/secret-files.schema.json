{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/telegram-userbot/secret-files.schema.json",
  "title": "Content-free production secret file contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "content_free", "source_root", "files"],
  "properties": {
    "schema_version": {"const": 1},
    "content_free": {"const": true},
    "source_root": {"const": "/etc/telegram-userbot/secrets"},
    "files": {
      "type": "array",
      "minItems": 23,
      "maxItems": 23,
      "items": {"$ref": "#/$defs/secretFile"}
    }
  },
  "$defs": {
    "secretFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "filename",
        "services",
        "expected_uid",
        "expected_gid",
        "mode",
        "max_bytes"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$"},
        "filename": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$"},
        "services": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "app",
              "control",
              "worker",
              "migrate",
              "postgres",
              "postgres-bootstrap",
              "redis",
              "session-backup",
              "data-export",
              "erasure-ledger-export",
              "ops-monitor"
            ]
          }
        },
        "expected_uid": {"const": 0},
        "expected_gid": {"type": "integer", "minimum": 20000, "maximum": 29999},
        "mode": {"const": "0440"},
        "max_bytes": {"type": "integer", "minimum": 1, "maximum": 65536}
      }
    }
  }
}
